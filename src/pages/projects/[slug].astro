---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import ArticleMeta from '../../components/ArticleMeta.astro';
import PostLinks from '../../components/PostLinks.astro';
import SourceFooter from '../../components/SourceFooter.astro';
import AppStoreCard from '../../components/AppStoreCard.astro';
import CrateBadges from '../../components/CrateBadges.astro';
import RelatedByTags from '../../components/RelatedByTags.astro';
import { getCollection } from '../../lib/content';
import { renderMarkdown } from '../../lib/md';
import { ogCard } from '../../lib/og';
import { softwareApplicationLd } from '../../lib/software-ld';
import ProductFacts from '../../components/ProductFacts.astro';
import { productFor, projectLd } from '../../lib/registry';

export function getStaticPaths() {
  return getCollection('projects').map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const post = renderMarkdown(entry.raw);
const fm = post.frontmatter;
const appStoreId = fm.app_store_id;
const appStoreScreenshots = fm.app_store_screenshots;
const playStoreUrl = fm.play_store_url;
const hasBadges = fm.crate || fm.npm || fm.pypi;
const product = productFor(fm);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
// A SuperDuperAI product's SoftwareApplication lives on its home; here the page only refers to it.
const softwareLd = product ? projectLd(product, pageUrl, String(fm.title)) : await softwareApplicationLd(fm, pageUrl);
---

<BaseLayout title={post.frontmatter.title} description={post.frontmatter.description} ogImage={ogCard('projects', entry.slug)} article={{ date: post.frontmatter.created || post.frontmatter.date, updated: post.frontmatter.updated, tags: post.frontmatter.tags as string[] }} jsonLd={softwareLd ? [softwareLd] : []}>
  <BackLink href="/projects/" label="Projects" />

  {product && <ProductFacts product={product} />}

  {appStoreId && (
    <AppStoreCard
      appId={appStoreId}
      screenshots={appStoreScreenshots}
      playStoreUrl={playStoreUrl}
    />
  )}

  {hasBadges && (
    <CrateBadges crate={fm.crate} npm={fm.npm} pypi={fm.pypi} docs={fm.docs_url} github={fm.github} />
  )}

  <article class="prose dark:prose-invert max-w-none" data-pagefind-body data-pagefind-filter="section:projects">
    {post.frontmatter.title && !post.hasH1 && (
      <h1>{post.frontmatter.title}</h1>
    )}
    <ArticleMeta date={post.frontmatter.created || post.frontmatter.date} eventDate={post.frontmatter.event_date} tags={post.frontmatter.tags as string[]} />
    <PostLinks github={hasBadges ? undefined : fm.github} demo={fm.demo_url} video={fm.video_url} devpost={fm.devpost_url} />
    <Fragment set:html={post.html} />
  </article>

  <SourceFooter sourceUrls={post.frontmatter.source_url} sourcePath={post.frontmatter.source_path} />

  <RelatedByTags tags={post.frontmatter.tags as string[] || []} currentSlug={entry.slug} currentSection="projects" />
</BaseLayout>
