---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/config';
import { getAllContent } from '../lib/content';

const MODULE_META: Record<number, { title: string; description: string; outcome: string }> = {
  1: { title: 'Mindset & Decisions', description: 'Why build solo, and why a portfolio of small bets instead of one big one.', outcome: 'Your own reason written down, and a barbell: what pays the bills, what is the bet.' },
  2: { title: 'Harness Engineering', description: 'Set up the environment the agent works in, step by step: Claude Code from zero, CLAUDE.md, sensors and a stop gate that blocks on red, sandboxing, what it costs.', outcome: 'A harness on a real repo: CLAUDE.md under 200 lines, a turn that cannot end red, one agent mistake turned into a rule.' },
  3: { title: 'Memory, Skills & Tools', description: 'Working with agents day to day: what they remember across sessions, which skills they load, how they search, and when a cheaper model can do the reading.', outcome: 'Memory chosen by the questions you actually ask. One skill of your own used on a real task.' },
  4: { title: 'Measuring Agents', description: 'Benchmarks, evals with a baseline arm, and what competitions showed, including the gap between a dev set and the real run.', outcome: 'One eval run with and without your change, and a number for what it adds.' },
  5: { title: 'What to Build: Validation & Launch', description: 'Which projects are worth building: score a niche, one pain and one feature, a launch test before the code, weekly kill / iterate / scale. A hackathon is the cheapest jury there is.', outcome: 'One niche scored, one launch test run, a go or kill decision with a date.' },
  6: { title: 'Engineering Foundations', description: 'How the projects get built: schemas first, a CLI mirror for every project, tests at agreed seams, privacy by design, one deploy target.', outcome: 'A project built and tested through its CLI, and deployed.' },
  7: { title: 'Promotion', description: 'Getting the product seen and measured: search engines and AI agents reading your site, your own cookieless analytics, YouTube from the terminal, one video shipped to four channels, editing video with an AI assistant.', outcome: 'A site indexed and readable by agents, visitors counted without cookies, one video published everywhere.' },
  8: { title: 'Case Studies', description: 'The company and its projects, the current focus first: Life2Film. What each one is, how it was made, what it taught, including the ones that did not work.', outcome: 'Your own project shipped end to end with the method.' },
};

// Build course from frontmatter course_module + course_order
const all = getAllContent();
const courseItems = all.filter(e => e.frontmatter.course_module);

const modulesMap = new Map<number, typeof courseItems>();
for (const item of courseItems) {
  const mod = Number(item.frontmatter.course_module);
  if (!modulesMap.has(mod)) modulesMap.set(mod, []);
  modulesMap.get(mod)!.push(item);
}

// Sort items within each module by course_order
const modules = [...modulesMap.entries()]
  .sort(([a], [b]) => a - b)
  .map(([id, items]) => ({
    id,
    ...MODULE_META[id],
    items: items.sort((a, b) => Number(a.frontmatter.course_order || 99) - Number(b.frontmatter.course_order || 99)),
  }));

const totalLessons = modules.reduce((acc, m) => acc + m.items.length, 0);

---

<BaseLayout title="Course: AI Solopreneur Engineer" description={`From philosophy to production: ${modules.length} modules, ${totalLessons} lessons.`}>
  <div class="mb-10">
    <h1 class="text-2xl font-bold mb-2 font-mono prompt">AI Solopreneur Engineer</h1>
    <p class="text-[var(--color-muted)] mb-4">{modules.length} modules, {totalLessons} lessons. The path I took: a harness around coding agents, then working with them, then what to build, how to build it and how to promote it. Each lesson is a post; the course is the order to read them in.</p>
    <p class="text-sm text-[var(--color-muted)]">Powered by <a href="/projects/project-solo-factory/" class="link-muted hover:underline">solo-factory</a> — a Claude Code plugin that implements this methodology as executable skills.</p>
  </div>

  <nav class="mb-10 font-mono text-sm">
    <div class="flex flex-wrap gap-x-4 gap-y-1">
      {modules.map(mod => (
        <a href={`#module-${mod.id}`} class="link-muted">{mod.id}. {mod.title}</a>
      ))}
      <a href="/skills/" class="link-muted">Skills</a>
    </div>
  </nav>

  {modules.map(mod => (
    <section class="mb-10" id={`module-${mod.id}`}>
      <h2 class="text-lg font-semibold mb-1 prompt">Module {mod.id}: {mod.title}</h2>
      <p class="text-sm text-[var(--color-muted)] mb-1">{mod.description}</p>
      <p class="text-xs text-[var(--color-accent)] dark:text-[var(--color-accent-dim)] mb-3 font-mono">Result: {mod.outcome}</p>
      <div class="space-y-0 font-mono text-sm">
        {mod.items.map((item, i) => (
          <a href={`/${item.section}/${item.slug}/`} class="group flex items-baseline gap-3 py-1 hover:text-[var(--color-accent)] dark:hover:text-[var(--color-accent-dark)] transition-colors">
            <span class="text-xs text-[var(--color-muted)] shrink-0 w-8 text-right">{mod.id}.{i + 1}</span>
            <span class="text-xs uppercase text-[var(--color-muted)] dark:text-[var(--color-accent-dim)] shrink-0 w-14">{item.section}</span>
            <span class="truncate">{item.frontmatter.title || item.slug}</span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <div class="mt-8 pt-6 border-t border-[var(--color-border)] dark:border-[var(--color-border-dark)] text-sm text-[var(--color-muted)] font-mono">
    <p>New lessons auto-added when wiki pages get <code>course_module</code> in frontmatter.</p>
    <p class="mt-2">
      <a href="/wiki/manifest/" class="link-muted hover:underline">Manifesto</a> &middot;
      <a href="/projects/project-solo-factory/" class="link-muted hover:underline">Solo Factory</a> &middot;
      <a href="https://github.com/fortunto2/solo-factory" class="link-muted hover:underline" target="_blank" rel="noopener">GitHub</a> &middot;
      <a href={SITE.contact.calendar} class="link-muted hover:underline" target="_blank" rel="noopener">Book a call</a>
    </p>
  </div>
</BaseLayout>
