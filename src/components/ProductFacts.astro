---
/**
 * The registry's facts about a SuperDuperAI product, shown at the top of its project page: what
 * it is, where it lives, its status. The page's own text is the story; this box is the contract.
 */
import { homeUrl, privacyUrl, supportUrl, type Product } from '../lib/registry';
interface Props { product: Product }
const { product: p } = Astro.props;
const home = homeUrl(p);
const host = home.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
<aside class="not-prose mb-6 rounded-lg border border-[var(--color-border)] dark:border-[var(--color-border-dark)] p-4 text-sm" aria-label={`${p.name} at a glance`}>
  <p class="font-semibold">{p.name}</p>
  <p class="text-[var(--color-muted)] mt-1">{p.one_liner}</p>
  <p class="mt-3 font-mono text-xs flex flex-wrap gap-x-4 gap-y-1">
    <a href={home} class="underline">{host}</a>
    {p.links.app_store && <a href={p.links.app_store} class="underline" target="_blank" rel="noopener">App Store</a>}
    {p.links.play && <a href={p.links.play} class="underline" target="_blank" rel="noopener">Google Play</a>}
    <a href={privacyUrl(p)} class="underline">privacy</a>
    <a href={supportUrl(p)} class="underline">support</a>
    <span class="text-[var(--color-muted)]">{p.store_status} · {p.price}</span>
  </p>
</aside>
